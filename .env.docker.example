# Docker Environment Configuration Template
NODE_ENV=production
PORT=9000
LOG_LEVEL=info

# Internal Docker Network Service Addresses
MONGO_URI=mongodb://mongo:27017/prep
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=system_design_rubrics
LANGGRAPH_SERVICE_URL=http://langgraph:8001

# Security & Authentication
# Replace with a cryptographically secure 64-character secret in production
JWT_SECRET=production_super_secret_jwt_key_prep_platform_replace_me_in_prod
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# External AI Service Credentials
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
